@startuml
' hide the spot
' hide circle

' avoid problems with angled crows feet
skinparam linetype ortho

entity "Users"  
{
  *user_id: TEXT(uuid) <<primary>> 
  *current_user_type: user_type NOT NULL
  *user_email: varchar(255) NOT NULL
  *user_password: BINARY(32) <<hashed>> NOT NULL
  *user_name: varchar(255) NOT NULL
  *user_surname: varchar(255) NOT NULL
  *user_middle_name: varchar(255) default NULL
}

entity "Auth_sessions"  
{
  *id: TEXT(uuid) <<primary>> 
  *user_id:  foreign_key(Users.user_id)  NOT NULL
  *updated TIMESTAMPTZ NOT NULL DEFAULT NOW()
}

entity "Courses" {
  *course_id: TEXT(uuid) <<primary>> 
  *course_title: varchar(255) NOT NULL
  *course_description: TEXT NOT NULL
  --
  *author_id: foreign_key(Users.user_id) NOT NULL
  --
  *start_ts: TIMESTAMPTZ 
  *end_ts: TIMESTAMPTZ 
}

entity "Lessons" {
  *lesson_id: TEXT(uuid) <<primary>> 
  *lesson_title: varchar(255) NOT NULL
  *lesson_description: TEXT NOT NULL
  --
  *author_id: foreign_key(Users.user_id) NOT NULL
}

entity "Materials" {
  *material_id: TEXT(uuid) <<primary>> 
  *material_title: varchar(255) NOT NULL
  *content_link: TEXT NOT NULL
  --
  *author_id: foreign_key(Users.user_id) NOT NULL
}

entity "Tasks" {
  *task_id: TEXT(uuid) <<primary>> 
  *task_title: varchar(255) NOT NULL
  *content_link: TEXT NOT NULL
  --
  *author_id: foreign_key(Users.user_id) NOT NULL
}

Users ||..o| Auth_sessions
Users ||..o{ Courses
Users ||..o{ Materials
Users ||..o{ Lessons
Users ||..o{ Tasks


entity "User_Course" {
  *user_id: foreign_key(Users.user_id) NOT NULL
  *course_id: foreign_key(Courses.course_id) NOT NULL
  *user_role: user_role NOT NULL
  *id: primary_key(user_id, course_id, user_role)
}

entity "Course_Lesson" {
  *course_id: foreign_key(Courses.course_id)  NOT NULL
  *lesson_id: foreign_key(Lessons.lesson_id)  NOT NULL
  *id: primary_key(course_id, lesson_id)
}

entity "Lesson_Material" {
  *lesson_id: foreign_key(Lessons.lesson_id)  NOT NULL
  *material_id: foreign_key(Materials.material_id)  NOT NULL
  *id: primary_key(lesson_id, material_id)
}

entity "Lesson_Task" {
  *lesson_id: foreign_key(Lessons.lesson_id)  NOT NULL
  *task_id: foreign_key(Tasks.task_id)  NOT NULL
  *id: primary_key(lesson_id, task_id)
}

Users ||--o{ User_Course
Courses ||--o{ User_Course
Courses ||--o{ Course_Lesson
Lessons ||--o{ Course_Lesson
Lessons ||--o{ Lesson_Material
Materials ||--o{ Lesson_Material
Lessons ||--o{ Lesson_Task
Tasks ||--o{ Lesson_Task

entity "Course_Lesson_Task" {
  *course_lesson_id: foreign_key(Course_Lesson.id)  NOT NULL
  *lesson_task_id: foreign_key(Lesson_Task.id) NOT NULL
  *id: primary_key(course_id, task_id)
  *present_time: TIMESTAMPTZ NOT NULL default NOW()
  *submission_deadline: TIMESTAMPTZ 
  *review_deadline: TIMESTAMPTZ 
  *score: int 
}

Course_Lesson ||--o{ Course_Lesson_Task
Lesson_Task ||--o{ Course_Lesson_Task

entity Sended_Tasks{
  *student_id: foreign_key(User_Course.id)  NOT NULL
  *task_id: foreign_key(Course_Task.id)  NOT NULL
  *lesson_id: foreign_key(Course_Lesson.id) NOT NULL
  *id: primary_key(student_id, task_id, lesson_id)
  *status: status_code NOT NULL
  *score: int NOT NULL
  -- 
  *reviewer_id: foreign_key(User_Course.id)
}

Sended_Tasks }o--|| User_Course
Sended_Tasks }o--|| Course_Lesson_Task

entity TaskSubmissions{
  *sended_task_id: foreign_key(Sended_Tasks.id)  NOT NULL
  *send_ts: TIMESTAMPTZ NOT NULL default NOW()
  *content_link: TEXT NOT NULL
  
}

TaskSubmissions}o--|| Sended_Tasks
@enduml